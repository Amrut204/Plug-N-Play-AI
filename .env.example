# ==============================================================================
# Plug-N-Play AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="Plug-N-Play AI Data Layer"
PORT=8000

# Security (JWT & Token Signing)
# Generate a secure key in bash/powershell: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-char-secret-key-for-jwt-signing

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./plug_n_play_platform.db
# Cloud PostgreSQL (Neon Serverless, Supabase, Render Postgres):
# Format: postgresql+asyncpg://<username>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-host.neon.tech/neondb?ssl=require

# High-Speed Distributed Cache & Rate Limiting (Upstash Redis)
# Get a free serverless Redis instance at https://console.upstash.com/
# Format: rediss://default:<password>@<host>:6379
REDIS_URL=rediss://default:your-upstash-token@your-endpoint.upstash.io:6379

# Groq LPU API Keys (Triple-Key High-Availability Failover Pool)
# Get free API keys at https://console.groq.com/keys
# The gateway transparently load-balances and fails over on HTTP 429 rate limit errors
GROQ_API_KEY=gsk_primary_key_here
GROQ_API_KEY_1=gsk_secondary_failover_key_here
GROQ_API_KEY_2=gsk_tertiary_failover_key_here

# Default Model Provider & Model
DEFAULT_MODEL_PROVIDER=groq
DEFAULT_MODEL_NAME=qwen/qwen3.8-27b

# Optional LLM Providers (Leave blank if using Groq exclusively)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email / SMTP Configuration (OTP Verification & Escalation Alerts)
# For Gmail: Use a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM=your-account@gmail.com

# CORS Configuration
# Use "*" for development or public widget embedding. In restricted enterprise prod, set comma-separated domains.
CORS_ORIGINS=*
